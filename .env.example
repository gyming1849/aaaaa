# 复制为 .env 后按需修改（也可以直接设置环境变量）

# 端口与数据目录（数据库、上传的照片都在这里，记得备份）
PORT=8787
DATA_DIR=data

# AI 模式：auto（默认，有 API Key 用 api，否则有 claude 命令用 cli，都没有用 mock）
#          cli  = 调用本机 `claude -p`（需要先安装并登录 Claude Code）
#          api  = 直接调用 Anthropic API（需要 ANTHROPIC_API_KEY）
#          mock = 离线关键词估算（不需要任何 AI，精度有限）
AI_PROVIDER=auto
AI_MODEL=claude-opus-5-5
# 思考深度：low / medium / high / xhigh / max
AI_EFFORT=high
# 分析包装食品时是否允许联网查询营养成分表
AI_WEB_SEARCH=true
# 单次 AI 调用超时（毫秒）与并发数
AI_TIMEOUT_MS=480000
AI_CONCURRENCY=2
# claude 命令路径（cli 模式）
CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=sk-ant-...

# 多人站点：设置后注册需要邀请码；或直接关闭注册
INVITE_CODE=
ALLOW_REGISTRATION=true

# 部署在 HTTPS 反向代理后面时设为 true
COOKIE_SECURE=false
SESSION_DAYS=30

# 定时任务：每天结算、每周一/每月 1 日生成报告与 AI 点评
SCHEDULER=true
WEEKLY_AI_SUMMARY=true
